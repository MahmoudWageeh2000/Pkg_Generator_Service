<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="app.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Identity.Client" Version="4.90.0" />
		<PackageReference Include="NPOI" Version="2.6.2" />
		<PackageReference Include="OfficeOpenXml.Extension.AspNetCore" Version="1.0.0" />
		<PackageReference Include="Scriban" Version="5.12.0" />
		<PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
		<PackageReference Include="System.Drawing.Common" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="System.Formats.Asn1" Version="11.0.0-rc.1.26425.128" />
	</ItemGroup>

	<ItemGroup>
		<None Update="config.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>